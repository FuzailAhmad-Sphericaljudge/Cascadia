NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_STORE=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://cascadia:replace-with-the-same-url-encoded-password@postgres:5432/cascadia
JWT_SECRET=replace-with-a-long-random-local-tool-signing-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key
PUBLIC_APP_URL=https://cascadia.example.com
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_CLIENT_ID=cascadia-web
OIDC_CLIENT_SECRET=replace-with-the-provider-client-secret
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,fido,webauthn
OIDC_MFA_ACR_VALUES=
SESSION_TTL_MINUTES=480
OBSERVABILITY_TOKEN=replace-with-a-separate-long-random-monitoring-secret
# Optional manual notification destination. Use a dedicated HTTPS Slack, Teams, or generic webhook.
NOTIFICATION_WEBHOOK_URL=https://notifications.example.com/cascadia
NOTIFICATION_WEBHOOK_PROVIDER=generic
REQUESTS_PER_MINUTE=300
SERVE_WEB=true
WEB_DIST_DIR=/app/apps/web/dist
TRUST_PROXY_HOPS=1
